# ============================================================
#  DUOMAN Backend - Variables de entorno
# ============================================================
#  Copiá este archivo a `.env` y completá los valores con los de
#  tu proyecto de Supabase. NUNCA subas `.env` al repositorio.
#  Los valores que piden `<...>` son de tu proyecto real.
# ============================================================

# ------------------------------------------------------------
# SUPABASE
# ------------------------------------------------------------
# URL del proyecto. Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://<TU_PROYECTO>.supabase.co

# Service Role Key (secreta). Solo backend. Dashboard -> Settings -> API
# Cuidado: esta key tiene permisos elevados, nunca exponerla al frontend.
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>

# Anon / Public Key (pública). Dashboard -> Settings -> API
SUPABASE_ANON_KEY=<ANON_KEY>

# JWT Secret (solo proyectos legacy HS256). Dashboard -> Settings -> API -> JWT Settings
# NOTA: tu proyecto usa firma asimétrica (ES256). La verificación de tokens se hace
# automáticamente contra el endpoint JWKS de Supabase; este campo queda como fallback.
SUPABASE_JWT_SECRET=<JWT_SECRET_O_KID>

# Ruta de conexión a Postgres para migraciones (Alembic).
# Dashboard -> Project Settings -> Database -> Connection string
# Usar la opción "Session pooler" en modo "PSQL" (psycopg2).
# Formato: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=postgresql://<USER>:<PASSWORD>@<HOST>:5432/postgres

# Bucket privado donde se guardan los CVs (mismo nombre a crear en Storage).
BUCKET_RESUMES=resumes

# ------------------------------------------------------------
# APLICACIÓN
# ------------------------------------------------------------
# development | production
APP_ENV=development

# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Puerto local para uvicorn (en Vercel lo inyecta la plataforma).
PORT=8000

# Orígenes permitidos por CORS, separados por coma.
# En desarrollo, la SPA Angular corre en http://localhost:4200
# En Vercel: dominio principal + previews por branch de duomanfe.
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://duomanfe.vercel.app,https://duomanfe-git-main-duoman.vercel.app,https://duomanfe-7cmf5px4m-duoman.vercel.app

# ------------------------------------------------------------
# CRON KEEPALIVE (evita que la BBDD se freezeee)
# ------------------------------------------------------------
# Secreto que protege `POST /api/v1/cron/keepalive`.
# Vercel Cron lo envía como header `Authorization: Bearer <CRON_SECRET>`.
# Generalo con:  openssl rand -hex 32   (o cualquier cadena larga aleatoria)
CRON_SECRET=<GENERAR_SECRETO_LARGO>

# ------------------------------------------------------------
# ADMIN (Supabase Auth)
# ------------------------------------------------------------
# El usuario admin se crea en Supabase Dashboard -> Authentication -> Users
# ("Add user"). Luego, en su app_metadata setear:  { "role": "admin" }.
# El login valida contra Supabase Auth y exige ese role.

# --- Solo para desarrollo/tests de integración. NO usar en producción. ---
# Email y password del admin. Si no los cargás, ese test se saltea.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ------------------------------------------------------------
# NOTIFICACIONES POR EMAIL (Resend)
# ------------------------------------------------------------
# API key de https://resend.com/api-keys. Sin key (o sin destinatario),
# la app funciona igual pero no envía mails.
RESEND_API_KEY=

# Remitente visible. Con la cuenta gratuita sin dominio verificado,
# Resend solo permite "onboarding@resend.dev" y únicamente hacia el
# mail dueño de la cuenta. Cuando verifiques tu dominio en Resend,
# cambiá este valor (ej: notificaciones@tudominio.com) sin tocar código.
NOTIFY_FROM_EMAIL=onboarding@resend.dev

# Destinatario que recibe el aviso de cada nueva cotización.
NOTIFY_EMAIL_TO=